<!-- Цвета The Cup of Tea. Зимой поверх них ложится WinterTheme.xaml (см. Themes.Apply); стили — в Theme.xaml. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="AccentColor">#34D399</Color>
    <SolidColorBrush x:Key="Bg" Color="#090B0A" />
    <SolidColorBrush x:Key="Side" Color="#0D100E" />
    <SolidColorBrush x:Key="Surface" Color="#131715" />
    <SolidColorBrush x:Key="Surface2" Color="#1A1F1C" />
    <SolidColorBrush x:Key="Surface3" Color="#222925" />
    <SolidColorBrush x:Key="Line" Color="#1F2622" />
    <SolidColorBrush x:Key="Text1" Color="#F2F5F3" />
    <SolidColorBrush x:Key="Text2" Color="#9BA59F" />
    <SolidColorBrush x:Key="Text3" Color="#626B66" />
    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="Up" Color="#7AA7FF" />
    <SolidColorBrush x:Key="OnAccent" Color="#08100B" />
    <!-- Фирменный переход: зелёный → салатовый -->
    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#34D399" Offset="0" />
        <GradientStop Color="#A3E635" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Heart" Color="#F43F5E" />

    <!-- ───── Кнопка питания: заливка и свечение по состоянию ───── -->
    <!-- Кольца вокруг кнопки, когда подключено -->
    <SolidColorBrush x:Key="RingOn1" Color="#334ADE80" />
    <SolidColorBrush x:Key="RingOn2" Color="#77A3E635" />
    <LinearGradientBrush x:Key="HeroOff" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#27302B" Offset="0" />
        <GradientStop Color="#181D1A" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="HeroOn" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#A3E635" Offset="0" />
        <GradientStop Color="#22C55E" Offset="0.55" />
        <GradientStop Color="#0E9F6E" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="HeroBusy" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F8C76A" Offset="0" />
        <GradientStop Color="#D9930F" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="HeroError" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FA9090" Offset="0" />
        <GradientStop Color="#D94848" Offset="1" />
    </LinearGradientBrush>
    <DropShadowEffect x:Key="HeroOffGlow" Color="#000000" BlurRadius="60" ShadowDepth="0" Opacity="0.4" />
    <DropShadowEffect x:Key="HeroOnGlow" Color="#4ADE80" BlurRadius="70" ShadowDepth="0" Opacity="0.6" />
    <DropShadowEffect x:Key="HeroBusyGlow" Color="#F5B544" BlurRadius="60" ShadowDepth="0" Opacity="0.45" />
    <DropShadowEffect x:Key="HeroErrorGlow" Color="#F87171" BlurRadius="60" ShadowDepth="0" Opacity="0.45" />
</ResourceDictionary>

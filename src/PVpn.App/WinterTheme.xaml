<!-- Зимнее оформление: те же ключи, что в Theme.xaml, — холодные оттенки. Подменяет значения Theme.xaml до того, как
     их прочтут стили (Themes.Apply), поэтому всё оформление окна берёт эти цвета без DynamicResource. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="AccentColor">#5CC8F2</Color>
    <SolidColorBrush x:Key="Bg" Color="#080B10" />
    <SolidColorBrush x:Key="Side" Color="#0B0F15" />
    <SolidColorBrush x:Key="Surface" Color="#10151C" />
    <SolidColorBrush x:Key="Surface2" Color="#161D26" />
    <SolidColorBrush x:Key="Surface3" Color="#1E2731" />
    <SolidColorBrush x:Key="Line" Color="#1B232D" />
    <SolidColorBrush x:Key="Text1" Color="#F1F5F9" />
    <SolidColorBrush x:Key="Text2" Color="#9AA6B5" />
    <SolidColorBrush x:Key="Text3" Color="#5E6A79" />
    <SolidColorBrush x:Key="Accent" Color="#5CC8F2" />
    <SolidColorBrush x:Key="Up" Color="#A5B4FC" />
    <SolidColorBrush x:Key="OnAccent" Color="#061018" />
    <!-- Лёд → сирень (как полярное сияние) -->
    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#67E8F9" Offset="0" />
        <GradientStop Color="#A5B4FC" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HeroOff" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#26303B" Offset="0" />
        <GradientStop Color="#161C24" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="HeroOn" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#CFFAFE" Offset="0" />
        <GradientStop Color="#38D0EE" Offset="0.5" />
        <GradientStop Color="#0B86B0" Offset="1" />
    </LinearGradientBrush>
    <DropShadowEffect x:Key="HeroOnGlow" Color="#38D0EE" BlurRadius="70" ShadowDepth="0" Opacity="0.55" />
    <SolidColorBrush x:Key="RingOn1" Color="#3338D0EE" />
    <SolidColorBrush x:Key="RingOn2" Color="#7767E8F9" />
</ResourceDictionary>

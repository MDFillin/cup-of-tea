<ui:FluentWindow x:Class="PVpn.App.RunningAppsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Запущенные программы"
                 Width="640" Height="560" MinWidth="480" MinHeight="400"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 ShowInTaskbar="False">
    <Grid Margin="16,0,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Запущенные программы" ShowMinimize="False" ShowMaximize="False" Margin="-16,0,-16,0" />

        <ui:TextBox x:Name="Search" Grid.Row="1" PlaceholderText="Поиск по имени или пути" Margin="0,8,0,8"
                    TextChanged="Search_TextChanged" Icon="{ui:SymbolIcon Search24}" />

        <Grid Grid.Row="2">
            <ListBox x:Name="List" SelectionMode="Extended" MouseDoubleClick="List_MouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2,4">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Path}" FontSize="12" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="Loading" Text="Собираю список программ…" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </Grid>

        <CheckBox x:Name="AsFolder" Grid.Row="3" IsChecked="True" Margin="0,10,0,0"
                  Content="Добавлять папку программы — правило не слетит после её обновления (Discord и т. п.)" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <ui:Button Content="Добавить" Appearance="Primary" Click="Add_Click" MinWidth="110" />
            <ui:Button Content="Отмена" Margin="8,0,0,0" Click="Cancel_Click" MinWidth="110" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>

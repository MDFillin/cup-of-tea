<!-- Палитра и стили The Cup of Tea (только тёмная тема). Поверх тёмной темы WPF-UI: её элементы (кнопки, поля, переключатели) остаются. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <FontFamily x:Key="Display">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="Body">Segoe UI Variable Text, Segoe UI</FontFamily>

    <Color x:Key="AccentColor">#34D399</Color>
    <SolidColorBrush x:Key="Bg" Color="#0D0F14" />
    <SolidColorBrush x:Key="Side" Color="#12151C" />
    <SolidColorBrush x:Key="Surface" Color="#171B23" />
    <SolidColorBrush x:Key="Surface2" Color="#1F2430" />
    <SolidColorBrush x:Key="Surface3" Color="#272D3A" />
    <SolidColorBrush x:Key="Line" Color="#232937" />
    <SolidColorBrush x:Key="Text1" Color="#F1F3F8" />
    <SolidColorBrush x:Key="Text2" Color="#9AA2B3" />
    <SolidColorBrush x:Key="Text3" Color="#666E80" />
    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="Up" Color="#7AA7FF" />
    <SolidColorBrush x:Key="OnAccent" Color="#0B0D12" />

    <!-- ───── Текст ───── -->
    <Style x:Key="H1" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Display}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Text1}" />
    </Style>
    <Style x:Key="Title" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{StaticResource Text1}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="Sub" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource Text2}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,2,0,0" />
    </Style>
    <Style x:Key="GroupTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Text2}" />
        <Setter Property="Margin" Value="4,22,0,8" />
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{StaticResource Text2}" />
        <Setter Property="Margin" Value="0,6,0,0" />
    </Style>

    <!-- ───── Карточки ───── -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
    </Style>
    <Style x:Key="Separator" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{StaticResource Line}" />
        <Setter Property="Margin" Value="66,0,0,0" />
    </Style>

    <!-- Значок сервера: страна или протокол -->
    <Style x:Key="Badge" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border Width="38" Height="38" CornerRadius="9" Background="{StaticResource Surface3}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.FontSize="12" TextElement.FontWeight="Bold" TextElement.Foreground="{StaticResource Text1}">
                            <ContentPresenter.Resources>
                                <!-- Флаг страны вместо букв -->
                                <DataTemplate DataType="{x:Type ImageSource}">
                                    <Image Source="{Binding}" Width="28" Height="28" />
                                </DataTemplate>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Квадратик со значком у строки настроек -->
    <Style x:Key="IconBox" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border Width="36" Height="36" CornerRadius="9" Background="{StaticResource Surface2}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{StaticResource Accent}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Строка настроек целиком — кнопка: открывает свою страницу -->
    <Style x:Key="RowButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{StaticResource Text1}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="Transparent" CornerRadius="12" Padding="16,0" MinHeight="62">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Surface2}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Surface2}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="RowValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource Text2}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="MaxWidth" Value="260" />
    </Style>
    <Style x:Key="Chevron" TargetType="ui:SymbolIcon">
        <Setter Property="Symbol" Value="ChevronRight24" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Margin" Value="10,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{StaticResource Text3}" />
    </Style>
    <!-- Строка с переключателем (не кнопка) -->
    <Style x:Key="Row" TargetType="Grid">
        <Setter Property="MinHeight" Value="62" />
        <Setter Property="Margin" Value="16,0" />
    </Style>

    <!-- ───── Сегменты: «Весь трафик / Только прокси» и режимы раздельного туннелирования ───── -->
    <Style x:Key="Segment" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{StaticResource Text2}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Root" CornerRadius="8" Padding="18,8" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Surface3}" />
                            <Setter Property="Foreground" Value="{StaticResource Text1}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsChecked" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Foreground" Value="{StaticResource Text1}" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SegmentBox" TargetType="Border">
        <Setter Property="CornerRadius" Value="11" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="Background" Value="{StaticResource Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- ───── Боковое меню ───── -->
    <Style x:Key="NavItem" TargetType="ListBoxItem">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{StaticResource Text2}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Root" Height="44" CornerRadius="9" Padding="14,0" Margin="12,2" Background="Transparent">
                        <Grid>
                            <Rectangle x:Name="Bar" Width="3" Height="18" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource Accent}"
                                       HorizontalAlignment="Left" Margin="-14,0,0,0" Visibility="Collapsed" />
                            <ContentPresenter VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Surface}" />
                            <Setter Property="Foreground" Value="{StaticResource Text1}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Surface2}" />
                            <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{StaticResource Text1}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Значок пункта меню: у выбранного — цвета акцента -->
    <Style x:Key="NavIcon" TargetType="ui:SymbolIcon">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Margin" Value="0,0,14,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Accent}" />
                <Setter Property="Filled" Value="True" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ───── Кнопка питания: заливка и свечение по состоянию ───── -->
    <LinearGradientBrush x:Key="HeroOff" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2C3344" Offset="0" />
        <GradientStop Color="#1F2430" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="HeroOn" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#4BE3A9" Offset="0" />
        <GradientStop Color="#1FA774" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="HeroBusy" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F8C76A" Offset="0" />
        <GradientStop Color="#D9930F" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="HeroError" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FA9090" Offset="0" />
        <GradientStop Color="#D94848" Offset="1" />
    </LinearGradientBrush>
    <DropShadowEffect x:Key="HeroOffGlow" Color="#000000" BlurRadius="60" ShadowDepth="0" Opacity="0.4" />
    <DropShadowEffect x:Key="HeroOnGlow" Color="#34D399" BlurRadius="60" ShadowDepth="0" Opacity="0.55" />
    <DropShadowEffect x:Key="HeroBusyGlow" Color="#F5B544" BlurRadius="60" ShadowDepth="0" Opacity="0.45" />
    <DropShadowEffect x:Key="HeroErrorGlow" Color="#F87171" BlurRadius="60" ShadowDepth="0" Opacity="0.45" />

    <!-- ───── Плитки с цифрами на главной ───── -->
    <Style x:Key="StatLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource Text2}" />
        <Setter Property="Margin" Value="8,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="StatValue" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Display}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Text1}" />
        <Setter Property="Margin" Value="0,8,0,0" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
</ResourceDictionary>

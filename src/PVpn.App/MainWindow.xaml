<ui:FluentWindow x:Class="PVpn.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:local="clr-namespace:PVpn.App"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance local:MainViewModel}"
                 Title="{x:Static local:Brand.Name}"
                 Icon="Assets/pvpn.ico"
                 Width="1100" Height="720" MinWidth="960" MinHeight="640"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 WindowCornerPreference="Round"
                 Background="{StaticResource Bg}"
                 Foreground="{StaticResource Text1}"
                 FontFamily="{StaticResource Body}"
                 FontSize="14">
    <Grid Background="{StaticResource Bg}">
        <!-- Всё содержимое растёт вместе с окном (масштаб задаёт MainWindow.xaml.cs) -->
        <Border x:Name="Scaled">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="236" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ═════════ Боковое меню ═════════ -->
                <Border Background="{StaticResource Side}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="26,22,0,26">
                            <Image Source="Assets/logo.png" Width="36" Height="36" RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock Text="{x:Static local:Brand.Name}" FontFamily="{StaticResource Display}" FontSize="20" FontWeight="Bold" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Состояние видно с любой страницы -->
                        <StackPanel DockPanel.Dock="Bottom" Margin="16,0,16,16">
                            <Border Padding="14,12" CornerRadius="10" Background="{StaticResource Surface}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="{Binding StateBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding StatusTitle}" FontWeight="SemiBold" Margin="8,0,0,0" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Sub}" Margin="16,3,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                               Visibility="{Binding ConnectedServer, Converter={x:Static local:EmptyToCollapsed.Instance}}">
                                        <Run Text="{Binding ConnectedServer, Mode=OneWay}" /><Run Text="{Binding IsTunMode, Mode=OneWay, Converter={x:Static local:ModeName.Instance}}" />
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <TextBlock FontSize="12" Foreground="{StaticResource Text3}" Margin="4,10,0,0">
                                <Run Text="{x:Static local:Brand.Name}" /> <Run Text="{Binding AppVersion, Mode=OneWay}" /><Run Text=" · служба" /> <Run Text="{Binding ServiceVersion, Mode=OneWay}" />
                            </TextBlock>
                            <!-- Авторство: красное сердце текстом — цветные эмодзи WPF не рисует -->
                            <TextBlock FontSize="11" Foreground="{StaticResource Text3}" Margin="4,4,0,0" TextWrapping="NoWrap">
                                <Run Text="All rights reserved by @kpenkuu4au" /><Run Text=" ♥" Foreground="{StaticResource Heart}" />
                            </TextBlock>
                        </StackPanel>

                        <ListBox x:Name="Nav" AutomationProperties.AutomationId="Nav" SelectedIndex="{Binding Page}"
                                 Background="Transparent" BorderThickness="0" Padding="0"
                                 ItemContainerStyle="{StaticResource NavItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBoxItem AutomationProperties.Name="Главная">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Home24" Style="{StaticResource NavIcon}" />
                                    <TextBlock Text="Главная" />
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem AutomationProperties.Name="Серверы">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Profiles.Count}" FontSize="13" FontWeight="Normal" Foreground="{StaticResource Text3}" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Earth24" Style="{StaticResource NavIcon}" />
                                        <TextBlock Text="Серверы" />
                                    </StackPanel>
                                </DockPanel>
                            </ListBoxItem>
                            <ListBoxItem AutomationProperties.Name="Маршруты">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="ArrowSplit24" Style="{StaticResource NavIcon}" />
                                    <TextBlock Text="Маршруты" />
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem AutomationProperties.Name="Настройки">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Settings24" Style="{StaticResource NavIcon}" />
                                    <TextBlock Text="Настройки" />
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem AutomationProperties.Name="Журнал">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="DocumentText24" Style="{StaticResource NavIcon}" />
                                    <TextBlock Text="Журнал" />
                                </StackPanel>
                            </ListBoxItem>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- ═════════ Страницы ═════════ -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- ───────── Главная ───────── -->
                    <Grid Grid.Row="0" Grid.RowSpan="2" Visibility="{Binding Page, Converter={x:Static local:ShowWhen.Instance}, ConverterParameter=0}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Мягкое свечение цвета состояния за кнопкой -->
                        <Ellipse Grid.RowSpan="3" Width="640" Height="520" VerticalAlignment="Top" Margin="0,-40,0,0" IsHitTestVisible="False"
                                 Fill="{Binding StateBrush}">
                            <Ellipse.OpacityMask>
                                <RadialGradientBrush>
                                    <GradientStop Color="#22FFFFFF" Offset="0" />
                                    <GradientStop Color="#00FFFFFF" Offset="1" />
                                </RadialGradientBrush>
                            </Ellipse.OpacityMask>
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding State}" Value="Off"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>

                        <!-- Объявление панели подписки (announce) -->
                        <Border Grid.Row="0" Grid.RowSpan="2" VerticalAlignment="Top" HorizontalAlignment="Center" MaxWidth="640" Margin="40,48,40,0"
                                Style="{StaticResource Card}" Padding="16,10" BorderBrush="{StaticResource AccentGradient}" BorderThickness="1"
                                Visibility="{Binding AnnounceText, Converter={x:Static local:EmptyToCollapsed.Instance}}">
                            <DockPanel>
                                <ui:Button DockPanel.Dock="Right" Icon="{ui:SymbolIcon Dismiss24}" Appearance="Transparent" Padding="6" VerticalAlignment="Top"
                                           ToolTip="Скрыть" AutomationProperties.Name="Скрыть объявление" Command="{Binding DismissAnnounceCommand}" />
                                <ui:Button DockPanel.Dock="Right" Content="Подробнее" Appearance="Transparent" Margin="8,0,4,0" VerticalAlignment="Center"
                                           Command="{Binding OpenLinkCommand}" CommandParameter="{Binding AnnounceUrl}"
                                           Visibility="{Binding AnnounceUrl, Converter={x:Static local:EmptyToCollapsed.Instance}}" />
                                <ui:SymbolIcon Symbol="Megaphone24" FontSize="20" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock Text="{Binding AnnounceText}" TextWrapping="Wrap" VerticalAlignment="Center" MaxHeight="100" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </Border>

                        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40,0">
                            <!-- Плашка состояния -->
                            <Grid HorizontalAlignment="Center">
                                <Border CornerRadius="14" Background="{Binding StateBrush}" Opacity="0.14" />
                                <StackPanel Orientation="Horizontal" Margin="12,5">
                                    <Ellipse Width="8" Height="8" Fill="{Binding StateBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding StateLabel}" FontWeight="SemiBold" Foreground="{Binding StateBrush}" Margin="8,0,0,0" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding BigStatus}" FontFamily="{StaticResource Display}" FontSize="42" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,6,0,0" />
                            <TextBlock Text="{Binding StatusDetail}" Foreground="{StaticResource Text2}" HorizontalAlignment="Center" TextAlignment="Center"
                                       TextWrapping="Wrap" MaxWidth="560"
                                       Visibility="{Binding StatusDetail, Converter={x:Static local:EmptyToCollapsed.Instance}}" />

                            <!-- Кнопка питания: цвет — по состоянию -->
                            <Button x:Name="PowerButton" Command="{Binding ToggleConnectCommand}" Margin="0,14,0,10" Cursor="Hand" HorizontalAlignment="Center"
                                    AutomationProperties.Name="{Binding ConnectButtonText}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Grid x:Name="Root" Width="210" Height="210" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                                            <Ellipse x:Name="Ring1" Stroke="{StaticResource Line}" StrokeThickness="1" />
                                            <Ellipse x:Name="Ring2" Margin="16" Stroke="{StaticResource Line}" StrokeThickness="1.5" />
                                            <Ellipse x:Name="Disc" Margin="32" Fill="{StaticResource HeroOff}" Effect="{StaticResource HeroOffGlow}" />
                                            <ui:SymbolIcon x:Name="Icon" Symbol="Power24" FontSize="58" Foreground="{StaticResource Text1}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding State}" Value="On">
                                                <Setter TargetName="Disc" Property="Fill" Value="{StaticResource HeroOn}" />
                                                <Setter TargetName="Disc" Property="Effect" Value="{StaticResource HeroOnGlow}" />
                                                <Setter TargetName="Ring1" Property="Stroke" Value="#334ADE80" />
                                                <Setter TargetName="Ring2" Property="Stroke" Value="#77A3E635" />
                                                <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource OnAccent}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="Busy">
                                                <Setter TargetName="Disc" Property="Fill" Value="{StaticResource HeroBusy}" />
                                                <Setter TargetName="Disc" Property="Effect" Value="{StaticResource HeroBusyGlow}" />
                                                <Setter TargetName="Ring1" Property="Stroke" Value="#33F5B544" />
                                                <Setter TargetName="Ring2" Property="Stroke" Value="#55F5B544" />
                                                <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource OnAccent}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="Error">
                                                <Setter TargetName="Disc" Property="Fill" Value="{StaticResource HeroError}" />
                                                <Setter TargetName="Disc" Property="Effect" Value="{StaticResource HeroErrorGlow}" />
                                                <Setter TargetName="Ring1" Property="Stroke" Value="#33F87171" />
                                                <Setter TargetName="Ring2" Property="Stroke" Value="#55F87171" />
                                                <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource OnAccent}" />
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Ring1" Property="StrokeThickness" Value="2" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="Root" Property="RenderTransform">
                                                    <Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97" /></Setter.Value>
                                                </Setter>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="Root" Property="Opacity" Value="0.5" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Режим -->
                            <Border Style="{StaticResource SegmentBox}" HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Segment}" GroupName="Mode" IsChecked="{Binding IsTunMode}" IsEnabled="{Binding CanChangeMode}"
                                                 AutomationProperties.Name="Весь трафик (TUN)" ToolTip="Весь трафик компьютера идёт через VPN (нужна служба The Cup of Tea)">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Globe24" FontSize="16" />
                                            <TextBlock Text="Весь трафик (TUN)" Margin="8,0,0,0" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource Segment}" GroupName="Mode" IsChecked="{Binding IsProxyMode}" IsEnabled="{Binding CanChangeMode}"
                                                 AutomationProperties.Name="Только прокси" ToolTip="Через VPN идут только программы, которые используют системный прокси">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Window24" FontSize="16" />
                                            <TextBlock Text="Только прокси" Margin="8,0,0,0" />
                                        </StackPanel>
                                    </RadioButton>
                                </StackPanel>
                            </Border>

                            <ui:Button Content="Войти в сеть (гостиница, кафе)" Icon="{ui:SymbolIcon Globe24}" Margin="0,14,0,0" HorizontalAlignment="Center"
                                       Appearance="Primary" Command="{Binding LoginToNetworkCommand}"
                                       Visibility="{Binding ShowNetworkLogin, Converter={StaticResource BoolToVisibility}}"
                                       ToolTip="Сеть со страницей входа: VPN отключится, откроется страница входа, после входа VPN подключится сам" />
                            <ItemsControl ItemsSource="{Binding Warnings}" Margin="0,10,0,0" MaxWidth="560">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel HorizontalAlignment="Center">
                                            <ui:Button DockPanel.Dock="Right" Icon="{ui:SymbolIcon Dismiss16}" Appearance="Transparent" Padding="4" Margin="6,0,0,0" VerticalAlignment="Center"
                                                       Command="{Binding DataContext.DismissWarningCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       CommandParameter="{Binding}" ToolTip="Скрыть" AutomationProperties.Name="Скрыть предупреждение" />
                                            <TextBlock Text="{Binding StringFormat=⚠ {0}}" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" Foreground="{x:Static local:StatusBrushes.Busy}" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Margin="0,4,0,0" MaxWidth="560" Visibility="{Binding IsTunMode, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding ServiceNotice}" TextWrapping="Wrap" TextAlignment="Center" FontSize="13" Foreground="{x:Static local:StatusBrushes.Busy}"
                                           Visibility="{Binding ServiceNotice, Converter={x:Static local:EmptyToCollapsed.Instance}}" />
                                <ui:Button Content="Установить службу" Icon="{ui:SymbolIcon Shield24}" Margin="0,8,0,0" HorizontalAlignment="Center"
                                           Command="{Binding InstallServiceCommand}"
                                           Visibility="{Binding CanInstallService, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Сервер и цифры -->
                        <StackPanel Grid.Row="2" Margin="40,0,40,24">
                            <Border Style="{StaticResource Card}" Padding="16,14" DataContext="{Binding CurrentServer}"
                                    Visibility="{Binding Converter={x:Static local:NullToCollapsed.Instance}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ContentControl Style="{StaticResource Badge}" Content="{Binding Badge}" />
                                    <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                        <TextBlock local:FlagText.Text="{Binding DisplayName}" Style="{StaticResource Title}" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Details}" Style="{StaticResource Sub}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <!-- Задержка: при подключении — от службы, иначе из последней проверки -->
                                    <TextBlock Grid.Column="2" Text="{Binding DelayText}" FontSize="15" FontWeight="SemiBold" Foreground="{Binding DelayBrush}"
                                               VerticalAlignment="Center" Margin="0,0,20,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.State, RelativeSource={RelativeSource AncestorType=Window}}" Value="On">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0"
                                                DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding State}" Value="On">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <Ellipse Width="8" Height="8" Fill="{x:Static local:StatusBrushes.On}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding DelayText}" FontSize="15" FontWeight="SemiBold" Foreground="{x:Static local:StatusBrushes.On}" Margin="8,0,0,0" />
                                    </StackPanel>
                                    <ui:Button Grid.Column="3" Content="Сменить" VerticalAlignment="Center"
                                               Command="{Binding DataContext.GoToCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="1"
                                               ToolTip="Список серверов" />
                                </Grid>
                            </Border>

                            <UniformGrid Columns="4" Margin="-6,12,-6,0">
                                <UniformGrid.Style>
                                    <Style TargetType="UniformGrid">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding State}" Value="On">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </UniformGrid.Style>
                                <Border Style="{StaticResource Card}" Padding="16,12" Margin="6,0">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="ArrowDown24" FontSize="16" Foreground="{StaticResource Accent}" />
                                            <TextBlock Text="Загрузка" Style="{StaticResource StatLabel}" />
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource StatValue}">
                                            <Run Text="{Binding DownSpeed, Mode=OneWay, Converter={x:Static local:ValuePart.Instance}, ConverterParameter=value}" /><Run
                                                 Text="{Binding DownSpeed, Mode=OneWay, Converter={x:Static local:ValuePart.Instance}, ConverterParameter=unit}" FontSize="14" FontWeight="Normal" Foreground="{StaticResource Text2}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Padding="16,12" Margin="6,0">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="ArrowUp24" FontSize="16" Foreground="{StaticResource Up}" />
                                            <TextBlock Text="Отдача" Style="{StaticResource StatLabel}" />
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource StatValue}">
                                            <Run Text="{Binding UpSpeed, Mode=OneWay, Converter={x:Static local:ValuePart.Instance}, ConverterParameter=value}" /><Run
                                                 Text="{Binding UpSpeed, Mode=OneWay, Converter={x:Static local:ValuePart.Instance}, ConverterParameter=unit}" FontSize="14" FontWeight="Normal" Foreground="{StaticResource Text2}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Padding="16,12" Margin="6,0">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="DataUsage24" FontSize="16" Foreground="{StaticResource Text2}" />
                                            <TextBlock Text="За сеанс" Style="{StaticResource StatLabel}" />
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource StatValue}">
                                            <Run Text="{Binding SessionTraffic, Mode=OneWay, Converter={x:Static local:ValuePart.Instance}, ConverterParameter=value}" /><Run
                                                 Text="{Binding SessionTraffic, Mode=OneWay, Converter={x:Static local:ValuePart.Instance}, ConverterParameter=unit}" FontSize="14" FontWeight="Normal" Foreground="{StaticResource Text2}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding TrafficText}" FontSize="12" Foreground="{StaticResource Text3}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Padding="16,12" Margin="6,0">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="GlobeLocation24" FontSize="16" Foreground="{StaticResource Text2}" />
                                            <TextBlock Text="Внешний IP" Style="{StaticResource StatLabel}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding PublicIp, TargetNullValue=—}" Style="{StaticResource StatValue}" FontSize="20" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                            <TextBlock Text="{Binding FooterInfo}" Style="{StaticResource Hint}" Margin="4,10,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                       Visibility="{Binding FooterInfo, Converter={x:Static local:EmptyToCollapsed.Instance}}" />
                        </StackPanel>
                    </Grid>

                    <!-- ───────── Серверы ───────── -->
                    <DockPanel Grid.Row="1" Margin="40,0,40,16" Visibility="{Binding Page, Converter={x:Static local:ShowWhen.Instance}, ConverterParameter=1}">
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="Серверы" Style="{StaticResource H1}" />
                            <TextBlock Text="Двойной щелчок — подключиться к серверу (при включённом VPN — переключиться)" Style="{StaticResource Sub}" FontSize="14" />
                        </StackPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,16,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <WrapPanel>
                                <ui:Button Content="Вставить ссылки" Icon="{ui:SymbolIcon ClipboardPaste24}" Appearance="Primary" Command="{Binding ImportClipboardCommand}"
                                           ToolTip="Добавить серверы из ссылок vless:// и hy2:// в буфере обмена, картинку с QR-кодом или подписку по ссылке https://" />
                                <ui:Button Content="Из файла" Icon="{ui:SymbolIcon DocumentAdd24}" Margin="8,0,0,0" Command="{Binding ImportFileCommand}"
                                           ToolTip="Текстовый файл со ссылками или картинка с QR-кодом" />
                                <ui:Button Icon="{ui:SymbolIcon QrCode24}" Margin="8,0,0,0" Command="{Binding ImportQrScreenCommand}" AutomationProperties.Name="QR с экрана"
                                           ToolTip="Найти QR-код на экране и добавить сервер (окно The Cup of Tea на секунду свернётся)" />
                                <ui:Button Content="Пинг" Icon="{ui:SymbolIcon Pulse24}" Margin="8,0,0,0" Command="{Binding CheckDelaysCommand}"
                                           ToolTip="Задержка через каждый сервер (настоящий запрос через VPN)" />
                            </WrapPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                <ui:Button Icon="{ui:SymbolIcon Edit24}" Margin="8,0,0,0" Command="{Binding EditProfileCommand}" AutomationProperties.Name="Изменить сервер" ToolTip="Изменить имя или ссылку сервера" />
                                <ui:Button Icon="{ui:SymbolIcon Share24}" Margin="8,0,0,0" Command="{Binding ShowQrCommand}" AutomationProperties.Name="QR сервера" ToolTip="Показать сервер QR-кодом (для телефона)" />
                                <ui:Button Icon="{ui:SymbolIcon Delete24}" Margin="8,0,0,0" Command="{Binding DeleteProfileCommand}" AutomationProperties.Name="Удалить сервер" ToolTip="Удалить сервер" />
                            </StackPanel>
                        </Grid>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <ComboBox DockPanel.Dock="Right" MinWidth="170" Margin="8,0,0,0" AutomationProperties.Name="Сортировка серверов"
                                      ItemsSource="{Binding SortChoices}" DisplayMemberPath="Title" SelectedValuePath="Key" SelectedValue="{Binding ServerSort}" />
                            <ui:TextBox PlaceholderText="Поиск по имени или адресу" Icon="{ui:SymbolIcon Search24}"
                                        Text="{Binding ServerFilter, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Поиск сервера" />
                        </DockPanel>

                        <Border Style="{StaticResource Card}" Padding="6">
                            <Grid>
                                <ListBox x:Name="ServerList" ItemsSource="{Binding ProfilesView}" SelectedItem="{Binding SelectedProfile}" PreviewMouseLeftButtonDown="ServerList_PreviewMouseLeftButtonDown"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" Background="Transparent" BorderThickness="0">
                                    <ListBox.GroupStyle>
                                        <GroupStyle>
                                            <GroupStyle.HeaderTemplate>
                                                <DataTemplate>
                                                    <TextBlock local:FlagText.Text="{Binding Name}" Style="{StaticResource GroupTitle}" Margin="12,10,0,6" />
                                                </DataTemplate>
                                            </GroupStyle.HeaderTemplate>
                                        </GroupStyle>
                                    </ListBox.GroupStyle>
                                    <!-- Выбранный сервер — подсветка и полоска цвета акцента -->
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Margin" Value="0,0,0,2" />
                                            <Setter Property="Cursor" Value="Hand" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="Root" Background="Transparent" CornerRadius="9" Padding="12,8">
                                                            <Grid>
                                                                <Rectangle x:Name="Bar" Width="3" Height="20" RadiusX="1.5" RadiusY="1.5"
                                                                           HorizontalAlignment="Left" Margin="-10,0,0,0" Visibility="Collapsed" Fill="{StaticResource Accent}" />
                                                                <ContentPresenter />
                                                            </Grid>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Root" Property="Background" Value="{StaticResource Surface2}" />
                                                            </Trigger>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="Root" Property="Background" Value="{StaticResource Surface2}" />
                                                                <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type local:ProfileItem}">
                                            <Grid ToolTip="{Binding Profile.Name}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ContentControl Style="{StaticResource Badge}" Content="{Binding Badge}" />
                                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock local:FlagText.Text="{Binding DisplayName}" Style="{StaticResource Title}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Details}" Style="{StaticResource Sub}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding DelayText}" Foreground="{Binding DelayBrush}" FontWeight="SemiBold"
                                                           VerticalAlignment="Center" Margin="12,0,4,0" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Text="Серверов пока нет. Скопируйте ссылки vless:// или hy2:// либо ссылку подписки и нажмите «Вставить ссылки»."
                                           TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" Margin="32" Foreground="{StaticResource Text2}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Profiles.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </DockPanel>

                    <!-- ───────── Маршруты (раздельное туннелирование) ───────── -->
                    <Grid Grid.Row="1" Margin="40,0,40,16" DataContext="{Binding Split}"
                          Visibility="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static local:ShowWhen.Instance}, ConverterParameter=2}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="Маршруты" Style="{StaticResource H1}" />
                            <TextBlock Text="Какие программы и сайты идут через VPN, а какие напрямую. Изменения можно применить без переподключения." Style="{StaticResource Sub}" FontSize="14" />
                            <Border Style="{StaticResource Card}" Padding="20,12" Margin="0,16,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Маршруты из подписки" FontFamily="{StaticResource Display}" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Style="{StaticResource Sub}" TextWrapping="Wrap"
                                                   Text="Для серверов, которые панель отдаёт полным конфигом: их маршруты (например, российские сайты напрямую), DNS и автовыбор. Ваши правила ниже — главнее. Выключено — всё через сервер. Со следующего подключения." />
                                    </StackPanel>
                                    <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0" AutomationProperties.Name="Маршруты из подписки"
                                                     IsChecked="{Binding DataContext.UseServerRouting, RelativeSource={RelativeSource AncestorType=Window}}" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource Card}" Padding="20,12" Margin="0,12,0,0">
                                <StackPanel>
                                    <DockPanel>
                                        <ui:Button DockPanel.Dock="Right" Content="Из буфера" Icon="{ui:SymbolIcon ClipboardPaste24}" Margin="8,0,0,0" VerticalAlignment="Center"
                                                   ToolTip="Профиль маршрутизации из буфера обмена: JSON, base64 или ссылка …://routing/onadd/…"
                                                   Command="{Binding DataContext.ImportRoutingCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        <ComboBox DockPanel.Dock="Right" MinWidth="300" VerticalAlignment="Center" AutomationProperties.Name="Профиль маршрутизации"
                                                  ItemsSource="{Binding DataContext.RoutingChoices, RelativeSource={RelativeSource AncestorType=Window}}" DisplayMemberPath="Title" SelectedValuePath="Key"
                                                  SelectedValue="{Binding DataContext.RoutingChoice, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        <TextBlock Text="Профиль маршрутизации" FontFamily="{StaticResource Display}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <TextBlock Style="{StaticResource Sub}" Margin="0,6,0,0" Text="{Binding DataContext.RoutingSummary, RelativeSource={RelativeSource AncestorType=Window}}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="20,16" Margin="0,16,0,0">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Раздельное туннелирование" FontFamily="{StaticResource Display}" FontSize="18" FontWeight="SemiBold" />
                                        <TextBlock Text="Когда выключено, весь трафик идёт через VPN" Style="{StaticResource Sub}" />
                                    </StackPanel>
                                    <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding Enabled}" AutomationProperties.Name="Раздельное туннелирование" VerticalAlignment="Center" />
                                </Grid>
                                <Border Style="{StaticResource SegmentBox}" Background="{StaticResource Bg}" Margin="0,14,0,0">
                                    <UniformGrid Columns="2">
                                        <RadioButton Style="{StaticResource Segment}" Content="Всё через VPN, кроме выбранного" IsChecked="{Binding IsExcludeMode}" GroupName="SplitMode" />
                                        <RadioButton Style="{StaticResource Segment}" Content="Через VPN только выбранное" IsChecked="{Binding IsOnlyMode}" GroupName="SplitMode" />
                                    </UniformGrid>
                                </Border>
                                <TextBlock Text="⚠ Список пуст — пока ничего не выбрано, весь трафик идёт напрямую, без VPN." Margin="0,8,0,0"
                                           Foreground="{x:Static local:StatusBrushes.Busy}"
                                           Visibility="{Binding AllDirectWarning, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </Border>

                        <Grid Grid.Row="2" Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>

                            <!-- Программы -->
                            <Border Style="{StaticResource Card}" Padding="16,14">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" FontSize="16" FontWeight="SemiBold">
                                        <Run Text="Программы" /><Run Text="  " /><Run Text="{Binding ListTitle, Mode=OneWay}" FontWeight="Normal" FontSize="14" Foreground="{StaticResource Text2}" />
                                    </TextBlock>
                                    <WrapPanel DockPanel.Dock="Top" Margin="0,12,0,8">
                                        <ui:Button Content="Программа…" Icon="{ui:SymbolIcon Apps24}" Margin="0,0,8,0" Command="{Binding AddExeCommand}" />
                                        <ui:Button Content="Папка…" Icon="{ui:SymbolIcon Folder24}" Margin="0,0,8,0" Command="{Binding AddFolderCommand}"
                                                   ToolTip="Все программы внутри папки, в том числе после обновления (Discord меняет имя файла)" />
                                        <ui:Button Content="Из запущенных…" Icon="{ui:SymbolIcon AppsList24}" Command="{Binding AddRunningCommand}" />
                                    </WrapPanel>
                                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Hint}"
                                               Text="Папка — под правило попадают все программы внутри, даже после обновления. В режиме «Только прокси» правила для программ не действуют, только для сайтов." />
                                    <ListBox ItemsSource="{Binding Apps}" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             Background="Transparent" BorderThickness="0">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate DataType="{x:Type local:SplitAppItem}">
                                                <Grid Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <ContentControl Style="{StaticResource IconBox}">
                                                        <ui:SymbolIcon FontSize="18" Foreground="{StaticResource Text2}">
                                                            <ui:SymbolIcon.Style>
                                                                <Style TargetType="ui:SymbolIcon">
                                                                    <Setter Property="Symbol" Value="Apps24" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                                            <Setter Property="Symbol" Value="Folder24" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ui:SymbolIcon.Style>
                                                        </ui:SymbolIcon>
                                                    </ContentControl>
                                                    <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center" ToolTip="{Binding App.Path}">
                                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Title}" />
                                                        <TextBlock Text="{Binding Details}" Style="{StaticResource Sub}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <ui:Button Grid.Column="2" Icon="{ui:SymbolIcon Dismiss24}" Appearance="Transparent" Padding="6"
                                                               ToolTip="Убрать из списка" AutomationProperties.Name="Убрать из списка"
                                                               Command="{Binding DataContext.RemoveAppCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                               CommandParameter="{Binding}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </Border>

                            <!-- Сайты -->
                            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16,14">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" FontSize="16" FontWeight="SemiBold">
                                        <Run Text="Сайты" /><Run Text="  " /><Run Text="{Binding ListTitle, Mode=OneWay}" FontWeight="Normal" FontSize="14" Foreground="{StaticResource Text2}" />
                                    </TextBlock>
                                    <Grid DockPanel.Dock="Top" Margin="0,12,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ui:TextBox x:Name="DomainBox" PlaceholderText="например, gosuslugi.ru"
                                                    Text="{Binding NewDomain, UpdateSourceTrigger=PropertyChanged}" KeyDown="DomainBox_KeyDown" />
                                        <ui:Button Grid.Column="1" Icon="{ui:SymbolIcon Add24}" Appearance="Primary" Margin="8,0,0,0" Command="{Binding AddDomainCommand}" ToolTip="Добавить сайт"
                                                   AutomationProperties.Name="Добавить сайт" />
                                    </Grid>
                                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Hint}" Text="Правило действует и на все поддомены. «ru» — все сайты в зоне .ru." />
                                    <ListBox ItemsSource="{Binding Domains}" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <ui:SymbolIcon Symbol="Globe24" FontSize="18" Foreground="{StaticResource Text2}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding}" FontSize="15" Margin="12,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                    <ui:Button Grid.Column="2" Icon="{ui:SymbolIcon Dismiss24}" Appearance="Transparent" Padding="6"
                                                               ToolTip="Убрать из списка" AutomationProperties.Name="Убрать из списка"
                                                               Command="{Binding DataContext.RemoveDomainCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                               CommandParameter="{Binding}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </Border>
                        </Grid>

                        <!-- Правила поменяли при включённом VPN -->
                        <Border Grid.Row="3" Margin="0,12,0,0" Padding="16,10" CornerRadius="10" Background="{StaticResource Surface2}"
                                Visibility="{Binding DataContext.SplitPending, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
                            <DockPanel>
                                <ui:Button DockPanel.Dock="Right" Content="Применить сейчас" Appearance="Primary"
                                           Command="{Binding DataContext.ApplySplitCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                <TextBlock Text="Правила изменились. Применить к текущему подключению?" VerticalAlignment="Center" TextWrapping="Wrap" />
                            </DockPanel>
                        </Border>
                    </Grid>

                    <!-- ───────── Настройки ───────── -->
                    <ScrollViewer x:Name="SettingsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding Page, Converter={x:Static local:ShowWhen.Instance}, ConverterParameter=3}">
                        <Grid Margin="40,0,40,24">
                            <!-- Список настроек -->
                            <StackPanel Visibility="{Binding SettingsPage, Converter={x:Static local:ShowWhen.Instance}, ConverterParameter=none}">
                                <TextBlock Text="Настройки" Style="{StaticResource H1}" />
                                <TextBlock Text="Пункты со стрелкой открывают свою страницу" Style="{StaticResource Sub}" FontSize="14" />

                                <TextBlock Text="Подключение (со следующего подключения)" Style="{StaticResource GroupTitle}" />
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <Grid Style="{StaticResource Row}">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <ContentControl Style="{StaticResource IconBox}"><ui:SymbolIcon Symbol="ShieldLock24" FontSize="18" /></ContentControl>
                                            <StackPanel Grid.Column="1" Margin="14,10" VerticalAlignment="Center">
                                                <TextBlock Text="Kill switch" Style="{StaticResource Title}" />
                                                <TextBlock Text="Режим TUN: пока VPN включён или переподключается, интернет мимо туннеля закрыт. Локальная сеть, Radmin и VirtualBox работают." Style="{StaticResource Sub}" />
                                            </StackPanel>
                                            <ui:ToggleSwitch Grid.Column="2" IsChecked="{Binding KillSwitch}" AutomationProperties.Name="Kill switch" VerticalAlignment="Center" />
                                        </Grid>
                                        <Border Style="{StaticResource Separator}" />
                                        <Button Style="{StaticResource RowButton}" Command="{Binding OpenSettingsCommand}" CommandParameter="dns" AutomationProperties.AutomationId="Open_dns" AutomationProperties.Name="DNS">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <ContentControl Style="{StaticResource IconBox}"><ui:SymbolIcon Symbol="GlobeShield24" FontSize="18" /></ContentControl>
                                                <StackPanel Grid.Column="1" Margin="14,10" VerticalAlignment="Center">
                                                    <TextBlock Text="DNS" Style="{StaticResource Title}" />
                                                    <TextBlock Text="Режим TUN: DNS-over-HTTPS через туннель, проверка утечки" Style="{StaticResource Sub}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Dns.Selected}" Style="{StaticResource RowValue}" />
                                                    <ui:SymbolIcon Style="{StaticResource Chevron}" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                        <Border Style="{StaticResource Separator}" />
                                        <Button Style="{StaticResource RowButton}" Command="{Binding OpenSettingsCommand}" CommandParameter="bypass" AutomationProperties.AutomationId="Open_bypass" AutomationProperties.Name="Обход блокировок">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <ContentControl Style="{StaticResource IconBox}"><ui:SymbolIcon Symbol="ShieldGlobe24" FontSize="18" /></ContentControl>
                                                <StackPanel Grid.Column="1" Margin="14,10" VerticalAlignment="Center">
                                                    <TextBlock Text="Обход блокировок" Style="{StaticResource Title}" />
                                                    <TextBlock Text="Отпечаток TLS, фрагментация, mux, шумы и смена портов Hysteria2" Style="{StaticResource Sub}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Bypass.Summary}" Style="{StaticResource RowValue}" />
                                                    <ui:SymbolIcon Style="{StaticResource Chevron}" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                        <Border Style="{StaticResource Separator}" />
                                        <Button Style="{StaticResource RowButton}" Command="{Binding OpenSettingsCommand}" CommandParameter="tun" AutomationProperties.AutomationId="Open_tun" AutomationProperties.Name="Тонкая настройка TUN">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <ContentControl Style="{StaticResource IconBox}"><ui:SymbolIcon Symbol="Wrench24" FontSize="18" /></ContentControl>
                                                <StackPanel Grid.Column="1" Margin="14,10" VerticalAlignment="Center">
                                                    <TextBlock Text="Тонкая настройка TUN" Style="{StaticResource Title}" />
                                                    <TextBlock Text="Блокировка QUIC, MTU, сетевой стек" Style="{StaticResource Sub}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                    <TextBlock Text="{Binding MtuText, StringFormat=MTU {0}}" Style="{StaticResource RowValue}" />
                                                    <ui:SymbolIcon Style="{StaticResource Chevron}" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="Автоматика" Style="{StaticResource GroupTitle}" />
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <Grid Style="{StaticResource Row}">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <ContentControl Style="{StaticResource IconBox}"><ui:SymbolIcon Symbol="PlugConnected24" FontSize="18" /></ContentControl>
                                            <StackPanel Grid.Column="1" Margin="14,10" VerticalAlignment="Center">
                                                <TextBlock Text="Подключаться автоматически" Style="{StaticResource Title}" />
                                                <TextBlock Text="При запуске The Cup of Tea и в любой сети, кроме доверенных. Если вы сами включили или выключили VPN, в этой сети автоматика больше не вмешивается." Style="{StaticResource Sub}" />
                                            </StackPanel>
                                            <ui:ToggleSwitch Grid.Column="2" IsChecked="{Binding AutoConnect}" AutomationProperties.Name="Подключаться автоматически" VerticalAlignment="Center" />
                                        </Grid>
                                        <Border Style="{StaticResource Separator}" />
                                        <Grid Style="{StaticResource Row}">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <ContentControl Style="{StaticResource IconBox}"><ui:SymbolIcon Symbol="PlugDisconnected24" FontSize="18" /></ContentControl>
                                            <StackPanel Grid.Column="1" Margin="14,10" VerticalAlignment="Center">
                                                <TextBlock Text="Отключать VPN в доверенных сетях" Style="{StaticResource Title}" />
                                                <TextBlock Text="Дом, работа — там, где VPN не нужен" Style="{StaticResource Sub}" />
                                            </StackPanel>
                                            <ui:ToggleSwitch Grid.Column="2" IsChecked="{Binding DisconnectOnTrusted}" AutomationProperties.Name="Отключать VPN в доверенных сетях" VerticalAlignment="Center" />
                                        </Grid>
                                        <Border Style="{StaticResource Separator}" />
                                        <Button Style="{StaticResource RowButton}" Command="{Binding OpenSettingsCommand}" CommandParameter="trusted" AutomationProperties.AutomationId="Open_trusted" AutomationProperties.Name="Доверенные сети">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <ContentControl Style="{StaticResource IconBox}"><ui:SymbolIcon Symbol="HomeCheckmark24" FontSize="18" /></ContentControl>
                                                <StackPanel Grid.Column="1" Margin="14,10" VerticalAlignment="Center">
                                                    <TextBlock Text="Доверенные сети" Style="{StaticResource Title}" />
                                                    <TextBlock Text="{Binding CurrentNetworks, StringFormat=Сейчас: {0}}" Style="{StaticResource Sub}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                    <TextBlock Text="{Binding TrustedNetworks.Count}" Style="{StaticResource RowValue}" />
                                                    <ui:SymbolIcon Style="{StaticResource Chevron}" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="Серверы и обновления" Style="{StaticResource GroupTitle}" />
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <Button Style="{StaticResource RowButton}" Command="{Binding OpenSettingsCommand}" CommandParameter="subs" AutomationProperties.AutomationId="Open_subs" AutomationProperties.Name="Подписки">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <ContentControl Style="{StaticResource IconBox}"><ui:SymbolIcon Symbol="CloudSync24" FontSize="18" /></ContentControl>
                                                <StackPanel Grid.Column="1" Margin="14,10" VerticalAlignment="Center">
                                                    <TextBlock Text="Подписки" Style="{StaticResource Title}" />
                                                    <TextBlock Text="Серверы из панели (Remnawave, 3x-ui, Marzban), трафик и срок" Style="{StaticResource Sub}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Subscriptions.Count}" Style="{StaticResource RowValue}" />
                                                    <ui:SymbolIcon Style="{StaticResource Chevron}" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                        <Border Style="{StaticResource Separator}" />
                                        <Button Style="{StaticResource RowButton}" Command="{Binding OpenSettingsCommand}" CommandParameter="cores" AutomationProperties.AutomationId="Open_cores" AutomationProperties.Name="Ядра">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <ContentControl Style="{StaticResource IconBox}"><ui:SymbolIcon Symbol="ArrowDownload24" FontSize="18" /></ContentControl>
                                                <StackPanel Grid.Column="1" Margin="14,10" VerticalAlignment="Center">
                                                    <TextBlock Text="Ядра" Style="{StaticResource Title}" />
                                                    <TextBlock Text="xray и sing-box: версии, обновление с GitHub и откат" Style="{StaticResource Sub}" />
                                                </StackPanel>
                                                <ui:SymbolIcon Grid.Column="2" Style="{StaticResource Chevron}" />
                                            </Grid>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="Приложение" Style="{StaticResource GroupTitle}" />
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <Grid Style="{StaticResource Row}">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <ContentControl Style="{StaticResource IconBox}"><ui:SymbolIcon Symbol="WindowArrowUp24" FontSize="18" /></ContentControl>
                                            <StackPanel Grid.Column="1" Margin="14,10" VerticalAlignment="Center">
                                                <TextBlock Text="Запускать вместе с Windows" Style="{StaticResource Title}" />
                                                <TextBlock Text="Сразу в трей. Служба работает и без окна: это значок в трее и быстрый доступ." Style="{StaticResource Sub}" />
                                            </StackPanel>
                                            <ui:ToggleSwitch Grid.Column="2" IsChecked="{Binding StartWithWindows}" AutomationProperties.Name="Запускать вместе с Windows" VerticalAlignment="Center" />
                                        </Grid>
                                        <Border Style="{StaticResource Separator}" />
                                        <Grid Style="{StaticResource Row}">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <ContentControl Style="{StaticResource IconBox}"><ui:SymbolIcon Symbol="Alert24" FontSize="18" /></ContentControl>
                                            <StackPanel Grid.Column="1" Margin="14,10" VerticalAlignment="Center">
                                                <TextBlock Text="Уведомления" Style="{StaticResource Title}" />
                                                <TextBlock Text="Подключено, связь прервалась и восстановлена, ошибка — у часов, если окно The Cup of Tea не на переднем плане" Style="{StaticResource Sub}" />
                                            </StackPanel>
                                            <ui:ToggleSwitch Grid.Column="2" IsChecked="{Binding Notifications}" AutomationProperties.Name="Уведомления" VerticalAlignment="Center" />
                                        </Grid>
                                        <Border Style="{StaticResource Separator}" />
                                        <Grid Style="{StaticResource Row}">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <ContentControl Style="{StaticResource IconBox}"><ui:SymbolIcon Symbol="Keyboard24" FontSize="18" /></ContentControl>
                                            <StackPanel Grid.Column="1" Margin="14,10" VerticalAlignment="Center">
                                                <TextBlock Text="Горячая клавиша" Style="{StaticResource Title}" />
                                                <TextBlock Text="Подключить или отключить VPN из любой программы. Пусто — выключено." Style="{StaticResource Sub}" />
                                                <TextBlock Text="{Binding HotkeyError}" Foreground="{x:Static local:StatusBrushes.Error}" TextWrapping="Wrap" Margin="0,4,0,0"
                                                           Visibility="{Binding HotkeyError, Converter={x:Static local:EmptyToCollapsed.Instance}}" />
                                            </StackPanel>
                                            <ui:TextBox Grid.Column="2" Text="{Binding HotkeyText, UpdateSourceTrigger=PropertyChanged}" Width="170" VerticalAlignment="Center"
                                                        PlaceholderText="Ctrl+Alt+P" AutomationProperties.Name="Горячая клавиша" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- ── Страницы настроек: заголовок с кнопкой «назад» ── -->
                            <StackPanel Visibility="{Binding SettingsPage, Converter={x:Static local:EmptyToCollapsed.Instance}}">
                                <StackPanel Orientation="Horizontal" Margin="-8,0,0,18">
                                    <ui:Button Icon="{ui:SymbolIcon ArrowLeft24}" Appearance="Transparent" Command="{Binding OpenSettingsCommand}" CommandParameter="{x:Null}"
                                               AutomationProperties.Name="Назад к настройкам" ToolTip="Назад к настройкам" VerticalAlignment="Center" />
                                    <TextBlock Style="{StaticResource H1}" Margin="8,0,0,0" VerticalAlignment="Center" Text="{Binding SettingsPage, Converter={x:Static local:SettingsTitle.Instance}}" />
                                </StackPanel>

                                <!-- DNS -->
                                <StackPanel DataContext="{Binding Dns}" MaxWidth="760" HorizontalAlignment="Left"
                                            Visibility="{Binding DataContext.SettingsPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static local:ShowWhen.Instance}, ConverterParameter=dns}">
                                    <TextBlock Text="Режим TUN, действует со следующего подключения." Style="{StaticResource Sub}" FontSize="14" Margin="0,0,0,14" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Сервер DNS" VerticalAlignment="Center" Width="130" />
                                        <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Selected}" Width="320" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0" Visibility="{Binding IsCustom, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="Адрес DoH" VerticalAlignment="Center" Width="130" />
                                        <ui:TextBox Text="{Binding CustomUrl, UpdateSourceTrigger=PropertyChanged}" Width="440" PlaceholderText="https://dns.example.com/dns-query" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Error}" Foreground="{x:Static local:StatusBrushes.Error}" TextWrapping="Wrap" Margin="0,8,0,0"
                                               Visibility="{Binding Error, Converter={x:Static local:EmptyToCollapsed.Instance}}" />
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,18"
                                               Text="Запросы всех программ идут к выбранному серверу по DNS-over-HTTPS через туннель — провайдер их не видит. В режиме прокси адреса сайтов разрешает сервер VPN." />
                                    <StackPanel Orientation="Horizontal">
                                        <ui:Button Content="Проверить утечку DNS" Icon="{ui:SymbolIcon ShieldQuestion24}" Command="{Binding CheckLeakCommand}" />
                                        <ui:ProgressRing IsIndeterminate="True" Width="18" Height="18" Margin="10,0,0,0"
                                                         Visibility="{Binding Checking, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding LeakVerdict}" TextWrapping="Wrap" Margin="0,10,0,0" FontWeight="SemiBold"
                                               Visibility="{Binding LeakVerdict, Converter={x:Static local:EmptyToCollapsed.Instance}}" />
                                    <TextBlock Text="{Binding LeakDetails}" Style="{StaticResource Hint}" Margin="0,4,0,0"
                                               Visibility="{Binding LeakDetails, Converter={x:Static local:EmptyToCollapsed.Instance}}" />
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                               Text="Проверка обращается к сервису bash.ws (как dnsleaktest.com) и показывает, какие DNS-серверы разрешали адреса." />
                                </StackPanel>

                                <!-- Обход блокировок -->
                                <StackPanel DataContext="{Binding Bypass}" MaxWidth="760" HorizontalAlignment="Left"
                                            Visibility="{Binding DataContext.SettingsPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static local:ShowWhen.Instance}, ConverterParameter=bypass}">
                                    <StackPanel.Resources>
                                        <Style x:Key="FieldLabel" TargetType="TextBlock">
                                            <Setter Property="Width" Value="250" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                        </Style>
                                        <Style x:Key="FieldRow" TargetType="DockPanel">
                                            <Setter Property="Margin" Value="0,0,0,8" />
                                            <Setter Property="LastChildFill" Value="False" />
                                        </Style>
                                        <Style x:Key="FieldBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                            <Setter Property="Width" Value="170" />
                                        </Style>
                                        <Style x:Key="Group" TargetType="StackPanel">
                                            <Setter Property="Margin" Value="48,0,0,10" />
                                        </Style>
                                        <Style x:Key="ToggleHint" TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                                            <Setter Property="Margin" Value="48,2,0,14" />
                                        </Style>
                                    </StackPanel.Resources>
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,14" TextWrapping="Wrap"
                                               Text="Для серверов по ссылкам. У серверов, которые подписка отдаёт полным конфигом, свои настройки обхода (фрагментация, маски) — они не меняются." />
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,16"
                                               Text="Оба режима, со следующего подключения. Значения по умолчанию подходят большинству сетей. Меняйте, если провайдер начал рвать или тормозить соединения; «Сбросить» вернёт всё как было." />

                                    <DockPanel Style="{StaticResource FieldRow}">
                                        <TextBlock Text="Отпечаток TLS (VLESS)" Style="{StaticResource FieldLabel}" />
                                        <ComboBox ItemsSource="{Binding FingerprintChoices}" SelectedItem="{Binding Fingerprint}" Width="170" />
                                    </DockPanel>
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,14"
                                               Text="Каким браузером представляется подключение. «из ссылки» — как задал сервер (обычно chrome)." />

                                    <DockPanel Style="{StaticResource FieldRow}">
                                        <TextBlock Text="Режим XHTTP" Style="{StaticResource FieldLabel}" />
                                        <ComboBox ItemsSource="{Binding XhttpModeChoices}" SelectedItem="{Binding XhttpMode}" Width="170" />
                                    </DockPanel>
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,14"
                                               Text="auto подходит почти всегда. packet-up — если соединения XHTTP обрываются через несколько секунд; stream-one — один запрос на соединение." />

                                    <ui:ToggleSwitch Content="Фрагментация TLS ClientHello (VLESS)" IsChecked="{Binding Fragment}" />
                                    <TextBlock Style="{StaticResource ToggleHint}"
                                               Text="Начало TLS-соединения уходит кусками: фильтр провайдера не видит имя сайта и не рвёт REALITY." />
                                    <StackPanel Style="{StaticResource Group}" Visibility="{Binding Fragment, Converter={StaticResource BoolToVisibility}}">
                                        <DockPanel Style="{StaticResource FieldRow}">
                                            <TextBlock Text="Что резать (tlshello или 1-3)" Style="{StaticResource FieldLabel}" Width="202" />
                                            <TextBox Text="{Binding FragmentPackets, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" />
                                        </DockPanel>
                                        <DockPanel Style="{StaticResource FieldRow}">
                                            <TextBlock Text="Длина куска, байт" Style="{StaticResource FieldLabel}" Width="202" />
                                            <TextBox Text="{Binding FragmentLength, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" />
                                        </DockPanel>
                                        <DockPanel Style="{StaticResource FieldRow}">
                                            <TextBlock Text="Пауза между кусками, мс" Style="{StaticResource FieldLabel}" Width="202" />
                                            <TextBox Text="{Binding FragmentInterval, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" />
                                        </DockPanel>
                                    </StackPanel>

                                    <ui:ToggleSwitch Content="Мультиплексирование (mux) для VLESS по TCP" IsChecked="{Binding Mux}" />
                                    <TextBlock Style="{StaticResource ToggleHint}"
                                               Text="Несколько соединений программ идут внутри одного соединения с сервером — меньше рукопожатий. У Vision через mux идёт только UDP, у XHTTP mux не используется (у него свой XMUX)." />
                                    <StackPanel Style="{StaticResource Group}" Visibility="{Binding Mux, Converter={StaticResource BoolToVisibility}}">
                                        <DockPanel Style="{StaticResource FieldRow}">
                                            <TextBlock Text="Потоков TCP" Style="{StaticResource FieldLabel}" Width="202" />
                                            <TextBox Text="{Binding MuxConcurrency, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" />
                                        </DockPanel>
                                        <DockPanel Style="{StaticResource FieldRow}">
                                            <TextBlock Text="Потоков UDP (xudp)" Style="{StaticResource FieldLabel}" Width="202" />
                                            <TextBox Text="{Binding XudpConcurrency, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" />
                                        </DockPanel>
                                    </StackPanel>

                                    <ui:ToggleSwitch Content="Свои параметры XMUX (XHTTP)" IsChecked="{Binding CustomXmux}" />
                                    <TextBlock Style="{StaticResource ToggleHint}"
                                               Text="Выключено — как в ссылке, а если там нет — по умолчанию Xray: 3 соединения, каждое на 600–900 запросов и 30–50 минут. Пустое поле — значение Xray." />
                                    <StackPanel Style="{StaticResource Group}" Visibility="{Binding CustomXmux, Converter={StaticResource BoolToVisibility}}">
                                        <DockPanel Style="{StaticResource FieldRow}">
                                            <TextBlock Text="Соединений (maxConnections)" Style="{StaticResource FieldLabel}" Width="202" />
                                            <TextBox Text="{Binding XmuxMaxConnections, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" />
                                        </DockPanel>
                                        <DockPanel Style="{StaticResource FieldRow}">
                                            <TextBlock Text="или потоков (maxConcurrency)" Style="{StaticResource FieldLabel}" Width="202" />
                                            <TextBox Text="{Binding XmuxMaxConcurrency, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" />
                                        </DockPanel>
                                        <DockPanel Style="{StaticResource FieldRow}">
                                            <TextBlock Text="cMaxReuseTimes" Style="{StaticResource FieldLabel}" Width="202" />
                                            <TextBox Text="{Binding XmuxCMaxReuseTimes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" />
                                        </DockPanel>
                                        <DockPanel Style="{StaticResource FieldRow}">
                                            <TextBlock Text="hMaxRequestTimes" Style="{StaticResource FieldLabel}" Width="202" />
                                            <TextBox Text="{Binding XmuxHMaxRequestTimes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" />
                                        </DockPanel>
                                        <DockPanel Style="{StaticResource FieldRow}">
                                            <TextBlock Text="hMaxReusableSecs" Style="{StaticResource FieldLabel}" Width="202" />
                                            <TextBox Text="{Binding XmuxHMaxReusableSecs, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" />
                                        </DockPanel>
                                        <DockPanel Style="{StaticResource FieldRow}">
                                            <TextBlock Text="hKeepAlivePeriod, с" Style="{StaticResource FieldLabel}" Width="202" />
                                            <TextBox Text="{Binding XmuxHKeepAlivePeriod, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" />
                                        </DockPanel>
                                    </StackPanel>

                                    <ui:ToggleSwitch Content="Шумы перед подключением Hysteria2" IsChecked="{Binding Noises}" />
                                    <TextBlock Style="{StaticResource ToggleHint}"
                                               Text="Перед первым пакетом QUIC уходят мусорные данные — фильтру провайдера сложнее узнать Hysteria2." />
                                    <StackPanel Style="{StaticResource Group}" Visibility="{Binding Noises, Converter={StaticResource BoolToVisibility}}">
                                        <DockPanel Style="{StaticResource FieldRow}">
                                            <TextBlock Text="Тип" Style="{StaticResource FieldLabel}" Width="202" />
                                            <ComboBox ItemsSource="{Binding NoiseTypeChoices}" SelectedItem="{Binding NoiseType}" Width="170" />
                                        </DockPanel>
                                        <DockPanel Style="{StaticResource FieldRow}">
                                            <TextBlock Text="{Binding NoisePacketLabel}" Style="{StaticResource FieldLabel}" Width="202" />
                                            <TextBox Text="{Binding NoisePacket, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" />
                                        </DockPanel>
                                        <DockPanel Style="{StaticResource FieldRow}">
                                            <TextBlock Text="Пауза после шума, мс" Style="{StaticResource FieldLabel}" Width="202" />
                                            <TextBox Text="{Binding NoiseDelay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" />
                                        </DockPanel>
                                    </StackPanel>

                                    <DockPanel Style="{StaticResource FieldRow}">
                                        <TextBlock Text="Смена портов Hysteria2, раз в N с" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding HopInterval, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" />
                                    </DockPanel>
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,14"
                                               Text="Только если в ссылке hy2 диапазон портов (host:20000-30000 или mport=…) и сервер слушает весь диапазон." />

                                    <TextBlock Text="{Binding Error}" Foreground="{x:Static local:StatusBrushes.Error}" TextWrapping="Wrap" Margin="0,0,0,8"
                                               Visibility="{Binding Error, Converter={x:Static local:EmptyToCollapsed.Instance}}" />
                                    <ui:Button Content="Сбросить по умолчанию" Icon="{ui:SymbolIcon ArrowReset24}" Command="{Binding ResetCommand}" />
                                </StackPanel>

                                <!-- Тонкая настройка TUN -->
                                <StackPanel MaxWidth="760" HorizontalAlignment="Left"
                                            Visibility="{Binding SettingsPage, Converter={x:Static local:ShowWhen.Instance}, ConverterParameter=tun}">
                                    <TextBlock Text="Режим TUN, действует со следующего подключения." Style="{StaticResource Sub}" FontSize="14" Margin="0,0,0,14" />
                                    <ui:ToggleSwitch Content="Блокировать QUIC для VLESS" IsChecked="{Binding BlockQuic}" />
                                    <TextBlock Style="{StaticResource Hint}" Margin="48,2,0,18"
                                               Text="Для XHTTP и Vision: браузеры сразу переходят на TCP, который через них идёт быстрее и стабильнее. У Hysteria2 QUIC не режется — она сама работает по UDP." />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="MTU туннеля" VerticalAlignment="Center" Width="130" />
                                        <TextBox Text="{Binding MtuText, UpdateSourceTrigger=PropertyChanged}" Width="110" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,18"
                                               Text="1500 по умолчанию. Если отдельные сайты не грузятся или зависают большие загрузки, попробуйте 1400." />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Сетевой стек" VerticalAlignment="Center" Width="130" />
                                        <ComboBox ItemsSource="{Binding TunStackChoices}" SelectedItem="{Binding TunStack}" Width="110" AutomationProperties.Name="Сетевой стек" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="gvisor по умолчанию: соединения обрабатывает сам VPN. system и mixed передают TCP через стек Windows — бывает быстрее, но сетевой экран антивируса может задерживать новые соединения на десятки секунд." />
                                </StackPanel>

                                <!-- Доверенные сети -->
                                <StackPanel MaxWidth="760" HorizontalAlignment="Left"
                                            Visibility="{Binding SettingsPage, Converter={x:Static local:ShowWhen.Instance}, ConverterParameter=trusted}">
                                    <TextBlock Style="{StaticResource Sub}" FontSize="14" Margin="0,0,0,14"
                                               Text="В доверенной сети The Cup of Tea не подключается сам, а если включено «Отключать VPN в доверенных сетях» — отключается." />
                                    <DockPanel>
                                        <ui:Button DockPanel.Dock="Right" Content="Доверять этой сети" Icon="{ui:SymbolIcon ShieldCheckmark24}" Margin="8,0,0,0"
                                                   Command="{Binding TrustCurrentNetworkCommand}" />
                                        <ui:Button DockPanel.Dock="Right" Content="Добавить" Icon="{ui:SymbolIcon Add24}" Margin="8,0,0,0" Command="{Binding AddTrustedNetworkCommand}" />
                                        <ui:TextBox Text="{Binding TrustedNetworkText, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Имя сети (как в «Параметрах» Windows)" />
                                    </DockPanel>
                                    <ItemsControl ItemsSource="{Binding TrustedNetworks}" Margin="0,10,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource Card}" Padding="14,6" Margin="0,0,0,6">
                                                    <DockPanel>
                                                        <ui:Button DockPanel.Dock="Right" Icon="{ui:SymbolIcon Dismiss24}" Appearance="Transparent" ToolTip="Убрать из доверенных" AutomationProperties.Name="Убрать из доверенных"
                                                                   Command="{Binding DataContext.RemoveTrustedNetworkCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                   CommandParameter="{Binding}" />
                                                        <ui:SymbolIcon Symbol="HomeCheckmark24" FontSize="18" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                                        <TextBlock Text="{Binding}" VerticalAlignment="Center" FontSize="15" />
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Style="{StaticResource Hint}" Text="{Binding CurrentNetworks, StringFormat=Сейчас подключено: {0}. У Wi-Fi имя сети то же\, что в списке Wi-Fi; у кабеля — «Сеть»\, «Сеть 2».}" />
                                </StackPanel>

                                <!-- Подписки -->
                                <StackPanel MaxWidth="760" HorizontalAlignment="Left"
                                            Visibility="{Binding SettingsPage, Converter={x:Static local:ShowWhen.Instance}, ConverterParameter=subs}">
                                    <DockPanel>
                                        <ui:Button DockPanel.Dock="Right" Content="Добавить" Icon="{ui:SymbolIcon Add24}" Appearance="Primary" Margin="8,0,0,0" Command="{Binding AddSubscriptionCommand}" />
                                        <ui:TextBox x:Name="SubscriptionBox" Text="{Binding SubscriptionUrl, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Ссылка подписки https://…" />
                                    </DockPanel>
                                    <ui:ToggleSwitch Content="Пинг серверов при запуске и после обновления подписки" IsChecked="{Binding AutoPing}" Margin="0,14,0,0" />
                                    <ui:ToggleSwitch Content="Сообщать панели идентификатор устройства (HWID)" IsChecked="{Binding SendHwid}" Margin="0,10,0,0" />
                                    <TextBlock Style="{StaticResource Hint}" Margin="48,2,0,0"
                                               Text="По нему панели вроде Remnawave считают лимит устройств; без него такая подписка может не обновиться. Это хэш, а не серийный номер ПК." />
                                    <ItemsControl ItemsSource="{Binding Subscriptions}" Margin="0,12,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,8">
                                                    <DockPanel>
                                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <ui:Button Icon="{ui:SymbolIcon ArrowSync24}" ToolTip="Обновить сейчас" AutomationProperties.Name="Обновить подписку"
                                                                       Command="{Binding DataContext.UpdateSubscriptionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                            <ui:Button Icon="{ui:SymbolIcon Delete24}" Margin="6,0,0,0" ToolTip="Удалить подписку и её серверы" AutomationProperties.Name="Удалить подписку"
                                                                       Command="{Binding DataContext.RemoveSubscriptionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                        </StackPanel>
                                                        <StackPanel>
                                                            <TextBlock local:FlagText.Text="{Binding Name}" Style="{StaticResource Title}" FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding Description}" Style="{StaticResource Sub}"
                                                                       Visibility="{Binding Description, Converter={x:Static local:EmptyToCollapsed.Instance}}" />
                                                            <TextBlock Text="{Binding Details}" Style="{StaticResource Sub}" />
                                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Visibility="{Binding HasLinks, Converter={StaticResource BoolToVisibility}}">
                                                                <ui:Button Content="Поддержка" Icon="{ui:SymbolIcon ChatHelp24}" Padding="10,4" Margin="0,0,6,0"
                                                                           Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding SupportUrl}"
                                                                           Visibility="{Binding SupportUrl, Converter={x:Static local:EmptyToCollapsed.Instance}}" />
                                                                <ui:Button Content="Сайт" Icon="{ui:SymbolIcon Globe24}" Padding="10,4"
                                                                           Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding WebPageUrl}"
                                                                           Visibility="{Binding WebPageUrl, Converter={x:Static local:EmptyToCollapsed.Instance}}" />
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Notes}" Style="{StaticResource Sub}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                                       Visibility="{Binding Notes, Converter={x:Static local:EmptyToCollapsed.Instance}}" />
                                                            <ProgressBar Value="{Binding UsedPercent, Mode=OneWay}" Maximum="100" Height="4" Margin="0,6,12,0"
                                                                         Visibility="{Binding HasLimit, Converter={StaticResource BoolToVisibility}}" />
                                                            <TextBlock Text="{Binding Error}" FontSize="13" TextWrapping="Wrap" Foreground="{x:Static local:StatusBrushes.Error}"
                                                                       Visibility="{Binding Error, Converter={x:Static local:EmptyToCollapsed.Instance}}" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="Ссылку даёт панель сервера (Remnawave, 3x-ui, Marzban). Серверы обновляются сами раз в 12 часов или как скажет панель; трафик и срок — из её ответа. Ссылки VLESS и Hysteria2; если панель отдаёт полные конфиги — любые серверы xray (trojan, gRPC и др.) с её маршрутами и автовыбором." />
                                </StackPanel>

                                <!-- Ядра -->
                                <StackPanel DataContext="{Binding Cores}" MaxWidth="760" HorizontalAlignment="Left"
                                            Visibility="{Binding DataContext.SettingsPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static local:ShowWhen.Instance}, ConverterParameter=cores}">
                                    <ItemsControl ItemsSource="{Binding Lines}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontSize="15" Margin="0,0,0,4" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <ui:Button Content="Проверить обновления" Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding CheckCommand}" />
                                        <ui:Button Content="Обновить" Icon="{ui:SymbolIcon ArrowDownload24}" Margin="8,0,0,0" Command="{Binding UpdateCommand}" Appearance="Primary" />
                                        <ui:Button Content="Откатить" Icon="{ui:SymbolIcon ArrowUndo24}" Margin="8,0,0,0" Command="{Binding RollbackCommand}" />
                                        <ui:ProgressRing IsIndeterminate="True" Width="18" Height="18" Margin="10,0,0,0"
                                                         Visibility="{Binding Busy, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,10,0,0"
                                               Visibility="{Binding Message, Converter={x:Static local:EmptyToCollapsed.Instance}}" />
                                    <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="{x:Static local:StatusBrushes.Error}"
                                               Visibility="{Binding Error, Converter={x:Static local:EmptyToCollapsed.Instance}}" />
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,12,0,0"
                                               Text="Новые версии берутся только с официальных релизов на GitHub (XTLS/Xray-core, SagerNet/sing-box). Перед заменой служба сверяет SHA256 архива с GitHub, проверяет, что ядро запускается и принимает наши конфиги. Прежняя версия сохраняется — «Откатить» вернёт её. Работающее подключение не рвётся: новое ядро подействует со следующего." />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>

                    <!-- ───────── Журнал ───────── -->
                    <DockPanel Grid.Row="1" Margin="40,0,40,16" Visibility="{Binding Page, Converter={x:Static local:ShowWhen.Instance}, ConverterParameter=4}">
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="Журнал" Style="{StaticResource H1}" />
                            <TextBlock Text="Сообщения программы, службы и ядер — без ключей и ссылок" Style="{StaticResource Sub}" FontSize="14" />
                        </StackPanel>
                        <WrapPanel DockPanel.Dock="Top" Margin="0,16,0,12">
                            <ui:Button Content="Копировать" Icon="{ui:SymbolIcon Copy24}" Command="{Binding CopyLogsCommand}" />
                            <ui:Button Content="Восстановить сеть" Icon="{ui:SymbolIcon Wrench24}" Margin="8,0,0,0" Command="{Binding RepairCommand}"
                                       ToolTip="Отключиться и вернуть маршруты, kill switch, DNS и системный прокси к исходным" />
                            <ui:Button Content="Сохранить диагностику" Icon="{ui:SymbolIcon DocumentArrowDown24}" Margin="8,0,0,0" Command="{Binding SaveDiagnosticsCommand}"
                                       ToolTip="Архив на рабочем столе: журналы, сеть, настройки и серверы — без ключей. Его можно отправить тому, кто помогает разобраться." />
                        </WrapPanel>
                        <TextBox x:Name="LogBox" Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
                                 FontFamily="Cascadia Mono, Consolas" FontSize="12.5" TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 VerticalContentAlignment="Top" TextChanged="LogBox_TextChanged" IsVisibleChanged="LogBox_IsVisibleChanged" />
                    </DockPanel>

                    <!-- Сообщения для пользователя (результат импорта, ошибки) -->
                    <Border Grid.Row="2" Margin="40,0,40,16" Padding="14,8" CornerRadius="10" Background="{StaticResource Surface2}"
                            BorderBrush="{StaticResource Line}" BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Notice}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel>
                            <ui:Button DockPanel.Dock="Right" Icon="{ui:SymbolIcon Dismiss24}" Appearance="Transparent" Padding="6"
                                       Click="DismissNotice_Click" ToolTip="Скрыть" AutomationProperties.Name="Скрыть сообщение" />
                            <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- Кнопки окна и перетаскивание — поверх, без масштаба -->
        <ui:TitleBar x:Name="TitleBar" VerticalAlignment="Top" Height="40" ShowHelp="False" />
    </Grid>
</ui:FluentWindow>

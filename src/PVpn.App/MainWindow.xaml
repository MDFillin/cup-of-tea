<ui:FluentWindow x:Class="PVpn.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:local="clr-namespace:PVpn.App"
                 xmlns:pages="clr-namespace:PVpn.App.Pages"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance local:MainViewModel}"
                 Title="{x:Static local:Brand.Name}"
                 Icon="Assets/pvpn.ico"
                 Width="1100" Height="720" MinWidth="960" MinHeight="640"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 WindowCornerPreference="Round"
                 Background="{StaticResource Bg}"
                 Foreground="{StaticResource Text1}"
                 FontFamily="{StaticResource Body}"
                 FontSize="14">
    <Grid Background="{StaticResource Bg}">
        <!-- Всё содержимое растёт вместе с окном (масштаб задаёт MainWindow.xaml.cs) -->
        <Border x:Name="Scaled" IsEnabled="{Binding IsUsable}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="236" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ═════════ Боковое меню ═════════ -->
                <Border Background="{StaticResource Side}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="26,22,0,26">
                            <Image Source="Assets/logo.png" Width="36" Height="36" RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock Text="{x:Static local:Brand.Name}" FontFamily="{StaticResource Display}" FontSize="20" FontWeight="Bold" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Состояние видно с любой страницы -->
                        <StackPanel DockPanel.Dock="Bottom" Margin="16,0,16,16">
                            <Border Padding="14,12" CornerRadius="10" Background="{StaticResource Surface}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="{Binding StateBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding StatusTitle}" FontWeight="SemiBold" Margin="8,0,0,0" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Sub}" Margin="16,3,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                               Visibility="{Binding ConnectedServer, Converter={x:Static local:EmptyToCollapsed.Instance}}">
                                        <Run Text="{Binding ConnectedServer, Mode=OneWay}" /><Run Text="{Binding IsTunMode, Mode=OneWay, Converter={x:Static local:ModeName.Instance}}" />
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <TextBlock FontSize="12" Foreground="{StaticResource Text3}" Margin="4,10,0,0">
                                <Run Text="{x:Static local:Brand.Name}" /> <Run Text="{Binding AppVersion, Mode=OneWay}" /><Run Text=" · служба" /> <Run Text="{Binding ServiceVersion, Mode=OneWay}" />
                            </TextBlock>
                            <!-- Авторство: красное сердце текстом — цветные эмодзи WPF не рисует -->
                            <TextBlock FontSize="11" Foreground="{StaticResource Text3}" Margin="4,4,0,0" TextWrapping="NoWrap">
                                <Run Text="All rights reserved by @kpenkuu4au" /><Run Text=" ♥" Foreground="{StaticResource Heart}" />
                            </TextBlock>
                        </StackPanel>

                        <ListBox x:Name="Nav" AutomationProperties.AutomationId="Nav" SelectedIndex="{Binding Page}"
                                 Background="Transparent" BorderThickness="0" Padding="0"
                                 ItemContainerStyle="{StaticResource NavItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBoxItem AutomationProperties.Name="Главная">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Home24" Style="{StaticResource NavIcon}" />
                                    <TextBlock Text="Главная" />
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem AutomationProperties.Name="Серверы">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Profiles.Count}" FontSize="13" FontWeight="Normal" Foreground="{StaticResource Text3}" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Earth24" Style="{StaticResource NavIcon}" />
                                        <TextBlock Text="Серверы" />
                                    </StackPanel>
                                </DockPanel>
                            </ListBoxItem>
                            <ListBoxItem AutomationProperties.Name="Маршруты">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="ArrowSplit24" Style="{StaticResource NavIcon}" />
                                    <TextBlock Text="Маршруты" />
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem AutomationProperties.Name="Настройки">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Settings24" Style="{StaticResource NavIcon}" />
                                    <TextBlock Text="Настройки" />
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem AutomationProperties.Name="Журнал">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="DocumentText24" Style="{StaticResource NavIcon}" />
                                    <TextBlock Text="Журнал" />
                                </StackPanel>
                            </ListBoxItem>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- ═════════ Страницы ═════════ -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- ───────── Главная ───────── -->
                    
<pages:HomePage Grid.Row="0" Grid.RowSpan="2" />

                    <!-- ───────── Серверы ───────── -->
                    
<pages:ServersPage Grid.Row="1" />

                    <!-- ───────── Маршруты (раздельное туннелирование) ───────── -->
                    
<pages:RoutesPage Grid.Row="1" />

                    <!-- ───────── Настройки ───────── -->
                    
<pages:SettingsPage Grid.Row="1" />

                    <!-- ───────── Журнал ───────── -->
                    
<pages:LogPage Grid.Row="1" />

                    <!-- Сообщения для пользователя (результат импорта, ошибки) -->
                    <Border Grid.Row="2" Margin="40,0,40,16" Padding="14,8" CornerRadius="10" Background="{StaticResource Surface2}"
                            BorderBrush="{StaticResource Line}" BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Notice}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel>
                            <ui:Button DockPanel.Dock="Right" Icon="{ui:SymbolIcon Dismiss24}" Appearance="Transparent" Padding="6"
                                       Click="DismissNotice_Click" ToolTip="Скрыть" AutomationProperties.Name="Скрыть сообщение" />
                            <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- Обязательное обновление: перекрывает всё окно, пока программа не обновлена (MainViewModel.Update) -->
        <Grid Background="#F2080A09" Visibility="{Binding RequiredUpdate, Converter={x:Static local:NullToCollapsed.Instance}}" local:Motion.FadeInOnShow="True">
            <Border Style="{StaticResource Card}" Background="{StaticResource Surface}" MaxWidth="580" Margin="40"
                    Padding="34,30" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <ContentControl Style="{StaticResource IconBox}" HorizontalAlignment="Left">
                        <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="22" />
                    </ContentControl>
                    <TextBlock Text="Нужно обновить программу" FontFamily="{StaticResource Display}" FontSize="24" FontWeight="Bold"
                               Margin="0,16,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding RequiredUpdateText}" Style="{StaticResource Sub}" FontSize="14" Margin="0,8,0,0" TextWrapping="Wrap" />
                    <Border Margin="0,16,0,0" Padding="14,10" CornerRadius="10" Background="{StaticResource Surface2}"
                            Visibility="{Binding RequiredUpdateNotes, Converter={x:Static local:EmptyToCollapsed.Instance}}">
                        <ScrollViewer MaxHeight="170" VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding RequiredUpdateNotes}" TextWrapping="Wrap" Foreground="{StaticResource Text2}" />
                        </ScrollViewer>
                    </Border>
                    <TextBlock Text="{Binding UpdateText}" TextWrapping="Wrap" Margin="0,14,0,0"
                               Visibility="{Binding UpdateText, Converter={x:Static local:EmptyToCollapsed.Instance}}" />
                    <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                        <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon ArrowDownload24}" Content="{Binding UpdateButtonText}"
                                   Command="{Binding UpdateAppCommand}" Padding="18,9" AutomationProperties.AutomationId="RequiredUpdate_Install" />
                        <ui:Button Content="Выйти из программы" Command="{Binding ExitCommand}" Margin="10,0,0,0" Padding="18,9"
                                   AutomationProperties.AutomationId="RequiredUpdate_Exit" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Sub}" Margin="0,16,0,0" TextWrapping="Wrap"
                               Text="Уже включённый VPN не отключается. Отключить его можно из меню значка в трее." />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Кнопки окна и перетаскивание — поверх, без масштаба -->
        <ui:TitleBar x:Name="TitleBar" VerticalAlignment="Top" Height="40" ShowHelp="False" />
    </Grid>
</ui:FluentWindow>

<UserControl x:Class="PVpn.App.Pages.Settings.TunSettings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:PVpn.App"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:MainViewModel}">
    <!-- Тонкая настройка TUN -->
    <StackPanel MaxWidth="760" HorizontalAlignment="Left"
                Visibility="{Binding SettingsPage, Converter={x:Static local:ShowWhen.Instance}, ConverterParameter=tun}">
        <TextBlock Text="Режим TUN, действует со следующего подключения." Style="{StaticResource Sub}" FontSize="14" Margin="0,0,0,14" />
        <ui:ToggleSwitch Content="Блокировать QUIC для VLESS" IsChecked="{Binding BlockQuic}" />
        <TextBlock Style="{StaticResource Hint}" Margin="48,2,0,18"
                   Text="Для XHTTP и Vision: браузеры сразу переходят на TCP, который через них идёт быстрее и стабильнее. У Hysteria2 QUIC не режется — она сама работает по UDP." />
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="MTU туннеля" VerticalAlignment="Center" Width="130" />
            <TextBox Text="{Binding MtuText, UpdateSourceTrigger=PropertyChanged}" Width="110" />
        </StackPanel>
        <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,18"
                   Text="1500 по умолчанию. Если отдельные сайты не грузятся или зависают большие загрузки, попробуйте 1400." />
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Сетевой стек" VerticalAlignment="Center" Width="130" />
            <ComboBox ItemsSource="{Binding TunStackChoices}" SelectedItem="{Binding TunStack}" Width="110" AutomationProperties.Name="Сетевой стек" />
        </StackPanel>
        <TextBlock Style="{StaticResource Hint}"
                   Text="gvisor по умолчанию: соединения обрабатывает сам VPN. system и mixed передают TCP через стек Windows — бывает быстрее, но сетевой экран антивируса может задерживать новые соединения на десятки секунд." />
    </StackPanel>
</UserControl>
